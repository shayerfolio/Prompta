{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "prompta",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prompta-library",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PROMPTA_WORKSPACE_ID": "shared:587e9016-76bc-41a2-9b64-ba993ad94a6f",
    "PROMPTA_SESSION_TTL_SECONDS": "604800"
  },
  "triggers": {
    "crons": [
      "0 21 * * *"
    ]
  }
}
